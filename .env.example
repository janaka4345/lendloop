# =============================================================================
# LendLoop Runtime Configuration
# Zero NEXT_PUBLIC_* build-time env baking: the same container image runs in
# local, dev, qa, staging, and prod using runtime environment variables only.
# =============================================================================

# --- Next.js Web Container (required at runtime) -----------------------------
APP_ENV=local
APP_URL=http://localhost:3000
# For `docker compose up` with host `npx convex dev --local`, use http://host.docker.internal:3210
# (or your Convex dev cloud URL). For host `pnpm dev`, use http://127.0.0.1:3210.
CONVEX_URL=http://host.docker.internal:3210

# Clerk test keys (required for local auth and /readyz)
CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_replace_with_your_clerk_secret_key

# Optional overrides (leave unset unless needed)
# CLERK_FRONTEND_API_URL=
# Runtime-optional Sentry DSN (clean no-op when unset; sendDefaultPii: false)
# SENTRY_DSN=

# --- Local Docker Compose n8n + Mailpit Automation ---------------------------
# Keep N8N_JWT_SECRET and N8N_SERVICE_TOKEN identical to your Convex env vars.
N8N_ENCRYPTION_KEY=local-dev-n8n-encryption-key-change-me
N8N_JWT_SECRET=local-dev-n8n-jwt-secret-change-me
N8N_SERVICE_TOKEN=local-dev-n8n-service-token-change-me

# --- Convex Deployment Env Vars (set via `npx convex env set`, NOT Next.js) --
# CLERK_JWT_ISSUER_DOMAIN=https://<your-clerk-dev-domain>.clerk.accounts.dev
# CLERK_WEBHOOK_SECRET=whsec_...
# APP_URL=http://localhost:3000
# N8N_WEBHOOK_URL=http://localhost:5678/webhook/lendloop-loan-notification
# N8N_JWT_SECRET=local-dev-n8n-jwt-secret-change-me
# N8N_SERVICE_TOKEN=local-dev-n8n-service-token-change-me
# N8N_SERVICE_TOKEN_PREVIOUS=
# BOOTSTRAP_ADMIN_EMAILS=admin@example.com  # Dev only — leave UNSET in prod

# --- Authenticated Golden-Path Playwright E2E (optional, manual/post-deploy) -
# E2E_GOLDEN_ENABLED=true
# E2E_LENDER_EMAIL=lender@example.com
# E2E_LENDER_PASSWORD=replace-with-test-lender-password
# E2E_BORROWER_EMAIL=borrower@example.com
# E2E_BORROWER_PASSWORD=replace-with-test-borrower-password
# MAILPIT_API_URL=http://localhost:8025
