# LendLoop runtime configuration (zero NEXT_PUBLIC_* build-time env baking)
APP_ENV=local
APP_URL=http://localhost:3000
CONVEX_URL=http://127.0.0.1:3210

# Clerk test keys (required for local auth and /readyz)
CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_replace_with_your_clerk_secret_key

# Optional overrides
# CLERK_FRONTEND_API_URL=
# SENTRY_DSN=
