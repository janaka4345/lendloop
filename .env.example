# LendLoop runtime configuration (zero NEXT_PUBLIC_* build-time env baking)
APP_ENV=local
APP_URL=http://localhost:3000
CONVEX_URL=http://127.0.0.1:3210

# Clerk test keys (required for local auth and /readyz)
CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_replace_with_your_clerk_secret_key

# Local n8n + Mailpit automation secrets (also set N8N_WEBHOOK_URL, N8N_JWT_SECRET, N8N_SERVICE_TOKEN in Convex)
N8N_ENCRYPTION_KEY=local-dev-n8n-encryption-key-change-me
N8N_JWT_SECRET=local-dev-n8n-jwt-secret-change-me
N8N_SERVICE_TOKEN=local-dev-n8n-service-token-change-me

# Optional overrides
# CLERK_FRONTEND_API_URL=
# SENTRY_DSN=
