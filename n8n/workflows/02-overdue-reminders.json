{
  "name": "LendLoop — 02 Overdue Reminders",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      },
      "id": "b2a00002-0000-4000-8000-000000000001",
      "name": "Daily 09:00 UTC",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cfg-convex-site-url",
              "name": "convexSiteUrl",
              "value": "http://host.docker.internal:3211",
              "type": "string"
            },
            {
              "id": "cfg-batch-limit",
              "name": "batchLimit",
              "value": 100,
              "type": "number"
            },
            {
              "id": "cfg-from-email",
              "name": "fromEmail",
              "value": "noreply@lendloop.local",
              "type": "string"
            },
            {
              "id": "cfg-app-url",
              "name": "appUrl",
              "value": "http://localhost:3000",
              "type": "string"
            },
            {
              "id": "cfg-cursor",
              "name": "cursor",
              "value": "",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "b2a00002-0000-4000-8000-000000000002",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.convexSiteUrl }}/api/n8n/overdue-loans",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "limit",
              "value": "={{ $('Config').first().json.batchLimit }}"
            },
            {
              "name": "cursor",
              "value": "={{ $json.cursor || '' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "b2a00002-0000-4000-8000-000000000003",
      "name": "Fetch Overdue Loans Batch",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "__REPLACE_ON_IMPORT__",
          "name": "LendLoop Convex Service Token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const batch = $input.first().json || {};\nconst items = Array.isArray(batch.items) ? batch.items : [];\nconst config = $('Config').first().json;\n\nreturn items.map((loan) => ({\n  json: {\n    ...loan,\n    fromEmail: config.fromEmail,\n    appUrl: config.appUrl,\n    subject: `[LendLoop] Overdue return reminder: ${loan.listingName}`,\n    text: `Hi ${loan.borrowerName || 'Neighbor'},\\n\\nYour Loan for \"${loan.listingName}\" from ${loan.lenderName || 'your neighbor'} was due on ${loan.endDate} (${loan.daysOverdue} day(s) overdue).\\n\\nPlease coordinate returning the tool soon: ${config.appUrl}/my-requests\\n`,\n  },\n}));"
      },
      "id": "b2a00002-0000-4000-8000-000000000004",
      "name": "Expand Batch Items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [920, 220]
    },
    {
      "parameters": {
        "operation": "removeItemsSeenInPreviousExecutions",
        "dedupeValue": "={{ $json.idempotencyKey }}",
        "options": {}
      },
      "id": "b2a00002-0000-4000-8000-000000000005",
      "name": "Deduplicate Reminder Key",
      "type": "n8n-nodes-base.removeDuplicates",
      "typeVersion": 2,
      "position": [1140, 220]
    },
    {
      "parameters": {
        "fromEmail": "={{ $json.fromEmail }}",
        "toEmail": "={{ $json.borrowerEmail }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.text }}",
        "options": {}
      },
      "id": "b2a00002-0000-4000-8000-000000000006",
      "name": "Send Overdue Reminder Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1360, 220],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput",
      "credentials": {
        "smtp": {
          "id": "__REPLACE_ON_IMPORT__",
          "name": "LendLoop SMTP"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.convexSiteUrl }}/api/n8n/overdue-reminders/ack",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Idempotency-Key",
              "value": "={{ $json.idempotencyKey }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ loanId: $json.loanId, status: 'sent', attemptCount: 1 }) }}",
        "options": {}
      },
      "id": "b2a00002-0000-4000-8000-000000000007",
      "name": "Ack Reminder Sent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1620, 120],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput",
      "credentials": {
        "httpHeaderAuth": {
          "id": "__REPLACE_ON_IMPORT__",
          "name": "LendLoop Convex Service Token"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.convexSiteUrl }}/api/n8n/overdue-reminders/ack",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Idempotency-Key",
              "value": "={{ $json.idempotencyKey }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ loanId: $json.loanId, status: 'failed', attemptCount: 3, error: 'SMTP reminder delivery failed' }) }}",
        "options": {}
      },
      "id": "b2a00002-0000-4000-8000-000000000008",
      "name": "Ack Reminder Failed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1620, 320],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput",
      "credentials": {
        "httpHeaderAuth": {
          "id": "__REPLACE_ON_IMPORT__",
          "name": "LendLoop Convex Service Token"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-has-next-cursor",
              "leftValue": "={{ String($json.nextCursor || '') }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b2a00002-0000-4000-8000-000000000009",
      "name": "Has More Pages?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [920, 460]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "next-cursor",
              "name": "cursor",
              "value": "={{ $json.nextCursor }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "b2a00002-0000-4000-8000-000000000010",
      "name": "Set Next Cursor",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [680, 520]
    }
  ],
  "connections": {
    "Daily 09:00 UTC": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "Fetch Overdue Loans Batch",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Overdue Loans Batch": {
      "main": [
        [
          {
            "node": "Expand Batch Items",
            "type": "main",
            "index": 0
          },
          {
            "node": "Has More Pages?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Expand Batch Items": {
      "main": [
        [
          {
            "node": "Deduplicate Reminder Key",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Deduplicate Reminder Key": {
      "main": [
        [
          {
            "node": "Send Overdue Reminder Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Overdue Reminder Email": {
      "main": [
        [
          {
            "node": "Ack Reminder Sent",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Ack Reminder Failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has More Pages?": {
      "main": [
        [
          {
            "node": "Set Next Cursor",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Set Next Cursor": {
      "main": [
        [
          {
            "node": "Fetch Overdue Loans Batch",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "UTC",
    "errorWorkflow": "__REPLACE_ON_IMPORT__"
  },
  "tags": []
}
